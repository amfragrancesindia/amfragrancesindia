# Store settings. On Cloudflare, add them in the dashboard:
#   Workers & Pages → amfragrancesindia → Settings → Variables and Secrets
# (choose "Secret" for passwords and keys). For local development copy this
# file to .env.local. Never commit real values.
#
# The database is not set here: it is the D1 binding "DB" in wrangler.jsonc.

# Auth.js — required. Any long random string, e.g. from: npx auth secret
AUTH_SECRET=replace-with-a-long-random-string

# Public address of the site when it is not https://amfragrancesindia.com
# (e.g. the workers.dev address). On Cloudflare this is a *build* variable:
# Settings → Build → Variables and secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in (optional). The Google button only appears when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (optional). Online payment is offered only when all three are set.
# Webhook URL: https://<your-domain>/api/payment/webhook
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email through Resend (https://resend.com, optional). Without a key, emails
# are only written to the log. The sender's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="AM Fragrances <orders@amfragrancesindia.com>"
# Where new-order and contact-form notifications go (default: the store email
# in src/lib/site.ts).
STORE_NOTIFY_EMAIL=

# Shared rate limiting (optional). Falls back to per-instance limits when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
