// Database for the store: Cloudflare D1 (SQLite), reached through the
// @prisma/adapter-d1 driver adapter (see src/lib/prisma.ts).
//
// Products are managed in the admin panel (/admin/products) and stored here.
// Coupons live in code (src/lib/pricing.ts).
//
// After changing this file, create a new SQL file in /migrations (see
// DEPLOYMENT.md) and run it on D1.

generator client {
  // Keep the default output folder: the site imports the WebAssembly build of
  // this client ('@prisma/client/wasm'), which runs on Cloudflare Workers.
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Only used by the Prisma CLI. The site itself talks to D1 through the
  // DB binding in wrangler.jsonc.
  url      = "file:./dev.db"
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  phone          String?
  name           String?
  password       String?
  image          String?
  role           UserRole  @default(CUSTOMER)
  emailVerified  DateTime?
  phoneVerified  Boolean   @default(false)
  isActive       Boolean   @default(true)
  // Bumped whenever existing sign-ins must end (password reset/change,
  // account takeover by the verified owner). Checked on every request.
  sessionVersion Int       @default(0) @map("session_version")
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  addresses Address[]
  orders    Order[]

  @@map("users")
}

// Password-reset tokens (only a hash of the token is stored).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Address {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// Orders support guest checkout: the customer and address are stored as a
// snapshot on the order, and `userId` is set only when the buyer is signed in.
model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  // Sent by the checkout page so a retried request returns the same order
  // instead of creating a duplicate.
  checkoutKey       String?       @unique @map("checkout_key")
  userId            String?       @map("user_id")
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod     String
  customerName      String        @default("") @map("customer_name")
  customerEmail     String        @default("") @map("customer_email")
  customerPhone     String        @default("") @map("customer_phone")
  // No @default here: Prisma writes `DEFAULT {}` for SQLite, which D1 rejects.
  shippingAddress   Json          @map("shipping_address")
  couponCode        String?       @map("coupon_code")
  subtotal          Int
  discount          Int           @default(0)
  shipping          Int           @default(0)
  tax               Int           @default(0)
  total             Int
  paymentId         String?
  razorpayOrderId   String?       @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  trackingNumber    String?       @map("tracking_number")
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  savedAddress      Address?      @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingAddressId String?
  items             OrderItem[]

  @@index([customerEmail])
  @@index([userId])
  @@map("orders")
}

// Line items keep their own copy of the product details so an order never
// changes when the catalogue does. `productId` holds the product slug.
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  productId    String   @map("product_id")
  variantId    String?  @map("variant_id")
  variantLabel String   @default("") @map("variant_label")
  name         String
  image        String
  quantity     Int
  unitPrice    Int      @map("unit_price")
  total        Int
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// A product and everything about it lives in one row: sizes, photos and notes
// are JSON columns, so saving a product is a single write (D1 has no
// transactions, and a half-saved product must never reach the store).
model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  tagline        String   @default("")
  description    String   @default("")
  gender         String   @default("unisex")
  category       String   @default("perfume")
  concentration  String   @default("")
  /// Photo URLs in display order (the first one is the main photo).
  images         Json
  /// [{ id, size, price, mrp, inStock }] — `id` is what carts and orders reference.
  variants       Json
  /// { top: string[], heart: string[], base: string[] }
  notes          Json
  longevity      String   @default("")
  sillage        String   @default("")
  seasons        Json
  occasions      Json
  badge          String?
  bestseller     Boolean  @default(false)
  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  releasedAt     DateTime @default(now()) @map("released_at")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("products")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("newsletter_subscribers")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@map("contact_inquiries")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
